# Public HTTPS origin assigned by your host. Do not add /mcp.
MCP_PUBLIC_URL=https://your-service.example.com

# Generate separately, for example: openssl rand -hex 32
MCP_AUTH_SECRET=replace-with-at-least-32-random-characters

# Password used only on the MCP authorization page. Do not reuse your Money Lover password.
MCP_OWNER_PASSWORD=replace-with-a-long-unique-owner-password

# Prefer a fresh access token. Alternatively set MONEYLOVER_EMAIL and MONEYLOVER_PASSWORD.
MONEYLOVER_ACCESS_TOKEN=
MONEYLOVER_EMAIL=
MONEYLOVER_PASSWORD=

# Optional and sometimes required for writes by Money Lover / Cloudflare.
MONEYLOVER_CF_CLEARANCE=
MONEYLOVER_USER_AGENT=

# Optional tuning.
MONEYLOVER_TIMEOUT_MS=20000
MONEYLOVER_CATEGORY_LOOKBACK_DAYS=730
MONEYLOVER_WRITE_DELAY_MS=700
